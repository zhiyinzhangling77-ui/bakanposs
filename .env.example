# Configuration example for run_analysis_C.py and run_analysis_C.sh
#
# Copy this file to .env and customize the paths for your environment,
# then source it before running:
#
#   cp .env.example .env
#   # Edit .env with your paths
#   source .env
#   python3 run_analysis_C.py

# Path to Oran EC CSV file (half-hourly eddy covariance measurements)
export BAKANPOSS_ORAN_EC="/path/to/Oran_Ameriflux_Cereal_ASV_CLEAN_2018_2020.csv"

# Path to Tarazona EC CSV file (daily aggregated eddy covariance measurements)
export BAKANPOSS_TARA_EC="/path/to/Daily_Summary_Filtered_forPred_ActEne26.csv"

# Path to NDVI CSV file (MOD13Q1 16-day NDVI/EVI extracted via GEE)
export BAKANPOSS_NDVI_FILE="/path/to/MOD13Q1-NDVI-EVI-MOD13Q1-061-results.csv"

# Output directory for analysis results (figures, CSVs, logs)
export BAKANPOSS_OUTPUT_DIR="./output_analysis_C_v1"
